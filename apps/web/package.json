{
  "name": "@dugout/web",
  "version": "0.0.1",
  "private": true,
  "description": "Dugout Tactics mobile web client (Vite + React + PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dugout/cinematic": "workspace:*",
    "@dugout/engine": "workspace:*",
    "@dugout/packs": "workspace:*",
    "@dugout/protocol": "workspace:*",
    "@react-three/fiber": "^8.17.10",
    "dexie": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.0"
  }
}
