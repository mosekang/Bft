{
  "name": "@dugout/cinematic",
  "version": "0.0.1",
  "private": true,
  "description": "Turns engine game events into deterministic presentation timelines (camera, animation, ball paths, juice). No DOM, no three.js.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dugout/protocol": "workspace:*"
  }
}
